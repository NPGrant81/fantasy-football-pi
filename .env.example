# Copy this file to a local secret file (for example, backend/.env or /etc/fantasy-football-pi/backend.env)
# and replace placeholder values before running the app.
# Never commit a real .env file or production secret values to git.

APP_ENV=development
SECRET_KEY=replace-with-a-strong-random-secret-of-at-least-32-characters
DATABASE_URL=******127.0.0.1:5432/fantasy_football
AUTO_SEED_ON_STARTUP=0

ALLOWED_HOSTS=localhost,127.0.0.1,testserver
ALLOW_ALL_ORIGINS=0
FRONTEND_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ACCESS_TOKEN_COOKIE_NAME=ffpi_access_token
CSRF_COOKIE_NAME=ffpi_csrf_token
CSRF_HEADER_NAME=X-CSRF-Token
USE_COOKIE_AUTH=1
AUTH_COOKIE_SECURE=0
AUTH_COOKIE_SAMESITE=lax
REFRESH_TOKEN_COOKIE_NAME=ffpi_refresh_token

# Optional runtime controls
LIVE_SCORING_WATCHDOG_ENABLED=0
LIVE_SCORING_POLLING_ENABLED=0
PLAYER_NEWS_INGEST_ENABLED=0
FRONTEND_BASE_URL=http://localhost:5173

# External integrations
GEMINI_API_KEY=
GOOGLE_API_KEY=
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_ACCESS_TOKEN=
YAHOO_REFRESH_TOKEN=

# NFL roster provider configuration
NFL_ROSTER_PROVIDER=espn
NFL_ROSTER_PROVIDER_FALLBACK=espn
NFLDB_ROSTER_URL_TEMPLATE=

# Optional production/monitoring values
CONTENT_SECURITY_POLICY=
