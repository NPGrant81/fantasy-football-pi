# Local backend runtime settings (copy to backend/.env and adjust as needed)
DATABASE_URL=postgresql://postgres:football-pi@127.0.0.1:5432/fantasy_football
APP_ENV=development
SECRET_KEY=dev_secret_only_not_for_production
AUTO_SEED_ON_STARTUP=0
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
ALLOW_ALL_ORIGINS=0
FRONTEND_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ACCESS_TOKEN_COOKIE_NAME=ffpi_access_token
CSRF_COOKIE_NAME=ffpi_csrf_token
CSRF_HEADER_NAME=X-CSRF-Token
USE_COOKIE_AUTH=1
AUTH_COOKIE_SECURE=0
AUTH_COOKIE_SAMESITE=lax
REFRESH_TOKEN_COOKIE_NAME=ffpi_refresh_token
# Optional background schedulers. Enable only the jobs needed in this process.
LIVE_SCORING_WATCHDOG_ENABLED=0
LIVE_SCORING_POLLING_ENABLED=0
PLAYER_NEWS_INGEST_ENABLED=0
# Frontend URL used in invite email login links.
FRONTEND_BASE_URL=http://localhost:5173

# Yahoo Fantasy Sports OAuth2
# Get client ID and secret from https://developer.yahoo.com/apps/ (create a
# "Fantasy Sports" app with read scope).  Access/refresh tokens are generated
# the first time you authorize the app via the OAuth2 flow.
# These are read by etl/extract/extract_yahoo.py before falling back to
# the legacy oauth2.json file at the project root.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_ACCESS_TOKEN=
YAHOO_REFRESH_TOKEN=

# NFL roster provider selection
# Options: espn | nfldb
# Default behavior (when unset): primary=espn, fallback=espn
NFL_ROSTER_PROVIDER=espn
NFL_ROSTER_PROVIDER_FALLBACK=espn

# Required only when NFL_ROSTER_PROVIDER or fallback is nfldb.
# Must contain {season} and point to a CSV or JSON endpoint.
# Example:
# NFLDB_ROSTER_URL_TEMPLATE=https://your-data-host/rosters/{season}.csv
NFLDB_ROSTER_URL_TEMPLATE=
