# Code owners — drives automatic reviewer requests.
#
# Rules are evaluated top-to-bottom; the LAST matching rule wins, so keep the
# broad defaults first and the narrow, high-risk paths last. These paths mirror
# the buckets in `.github/labeler.yml` and `.github/workflows/detect-changes.yml`.
#
# Format: <path> @github-username

# ---- Broad defaults -------------------------------------------------------
/backend/          @NPGrant81
/frontend/         @NPGrant81
/etl/              @NPGrant81
/db/               @NPGrant81
/docs/             @NPGrant81
/.github/          @NPGrant81

# ---- High-risk surfaces (narrower rules override the defaults above) -------
# Auth, tokens, and RBAC.
/backend/core/security.py     @NPGrant81
/backend/core/config.py       @NPGrant81
/backend/routers/auth.py      @NPGrant81

# Schema changes are hard to reverse in production — review explicitly.
/backend/alembic/versions/    @NPGrant81
/backend/models.py            @NPGrant81
/backend/models/              @NPGrant81
/backend/database.py          @NPGrant81

# Dependency manifests (supply-chain surface).
/backend/requirements.txt             @NPGrant81
/backend/requirements-lock.txt        @NPGrant81
/backend/requirements-validation.txt  @NPGrant81
/frontend/package.json                @NPGrant81
/frontend/package-lock.json           @NPGrant81

# CI, deployment, and secrets handling.
/.github/workflows/  @NPGrant81
/deploy/             @NPGrant81
/ops/                @NPGrant81
/.gitleaks.toml      @NPGrant81
